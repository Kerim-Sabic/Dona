# Production Environment Configuration for Dona AI Assistant
# IMPORTANT: This is a template. Copy to .env.production and fill with real values
# NEVER commit the actual .env.production file

# ==================== AI Services ====================
DEEPSEEK_API_KEY=sk-prod-your-deepseek-api-key-here
OPENAI_API_KEY=sk-prod-your-openai-api-key-here
CLAUDE_API_KEY=sk-prod-your-claude-api-key-here

# ==================== Google Cloud ====================
GOOGLE_OAUTH_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-production-secret-here
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/auth/callback

GOOGLE_MAPS_API_KEY=AIzaSy-your-production-maps-key-here

# ==================== Twilio (SMS/Voice) ====================
TWILIO_ACCOUNT_SID=AC-your-production-account-sid
TWILIO_AUTH_TOKEN=your-production-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# ==================== News & Weather ====================
WORLD_NEWS_API_KEY=your-production-news-api-key
OPENWEATHER_API_KEY=your-production-weather-api-key

# ==================== Optional Services ====================
# Uncomment and configure if using these services

# Firebase (configured via google-services.json / GoogleService-Info.plist)
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_PROJECT_ID=your-project-id

# Sentry (Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Amplitude/Mixpanel (Analytics)
# AMPLITUDE_API_KEY=your-amplitude-key
# MIXPANEL_TOKEN=your-mixpanel-token

# ==================== Feature Flags ====================
# Enable/disable features in production
ENABLE_AI_FEATURES=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_GAMIFICATION=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ==================== Configuration ====================
# App environment
ENVIRONMENT=production
DEBUG_MODE=false
LOG_LEVEL=info

# API timeouts (seconds)
API_TIMEOUT=30
CONNECTION_TIMEOUT=30

# ==================== Security ====================
# Session timeout (minutes)
SESSION_TIMEOUT=60

# Enable SSL pinning
ENABLE_SSL_PINNING=true

# ==================== IMPORTANT NOTES ====================
# 1. NEVER commit this file with actual values
# 2. Store production keys in secure secret manager
# 3. Use different keys for dev, staging, and production
# 4. Rotate keys regularly (every 90 days recommended)
# 5. Restrict API key usage by IP/domain where possible
# 6. Monitor API usage for anomalies
